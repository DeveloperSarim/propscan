# Saudi Real Estate Scraper API — Environment Variables
# Copy this file to .env and edit as needed

# API Server
HOST=0.0.0.0
PORT=4823
DEBUG=false

# Playwright
HEADLESS=true              # false = you can watch the browser open
BROWSER_TIMEOUT=30000      # ms — page load timeout
PAGE_WAIT=3000             # ms — extra wait after page load
MAX_RETRIES=3
SEARCH_MAX_PAGES=5         # pages per search

# Cache TTLs (seconds)
CITIES_CACHE_TTL=86400     # 24 hours
AREAS_CACHE_TTL=86400      # 24 hours
PROPERTY_TYPES_CACHE_TTL=86400  # 24 hours

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# Requirements submitted via the Post form are emailed here.
# Using Gmail: create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=                 # e.g.  your@gmail.com
SMTP_PASS=                 # Gmail App Password (16 chars, no spaces)
ADMIN_EMAIL=               # e.g.  admin@example.com
